# CEE-AgentOS service used by the Hermes cee-hierarchical plugin.
CEE_HIERARCHICAL_TOOL_URL=http://127.0.0.1:8766
CEE_HIERARCHICAL_RESET_ON_START=0

# Qwen OpenAI-compatible endpoint. Replace these values on the robot machine.
OPENAI_BASE_URL=http://127.0.0.1:18011/v1
OPENAI_API_KEY=replace-me
QWEN_API_KEY=replace-me

# ROS2 runtime settings. Match the robot's existing ROS2 deployment.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# The ROS2 adapter should use one fixed frame for maps and saved semantic points.
CEE_ROBOT_MAP_FRAME=map
CEE_ROBOT_BASE_FRAME=base_link
CEE_ROBOT_ODOM_FRAME=odom
